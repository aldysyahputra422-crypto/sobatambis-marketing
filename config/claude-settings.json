{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "multica-ai/andrej-karpathy-skills"
      }
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/ECC"
      }
    },
    "genjutsu": {
      "source": {
        "source": "github",
        "repo": "AThevon/genjutsu"
      }
    },
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes"
      }
    },
    "lemolab": {
      "source": {
        "source": "github",
        "repo": "lemomo-ai/lemo-opuscar"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "ponytail@ponytail": true,
    "andrej-karpathy-skills@karpathy-skills": true
  },
  "env": {
    "DO_NOT_TRACK": "1"
  },
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m scripts.*)",
      "Bash(python -m scripts.*)",
      "Bash(python3 -m scripts.*)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/python -c *)",
      "Bash(python -c *)",
      "Bash(bash scripts/setup.sh)",
      "Bash(npm test --prefix template)",
      "Bash(npx remotion *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(git clone --depth 1 *)",
      "Bash(npx --yes skills add *)",
      "Write(videos/**)",
      "Edit(videos/**)",
      "Edit(config/panggung.yaml)",
      "Edit(config/notion.yaml)",
      "Edit(template/src/**)",
      "Write(template/src/**)",
      "Bash(npm install --prefix template *)",
      "Bash(npm install --prefix */template *)",
      "Bash(bash kantor/runtime/bin/kantor.sh *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/jalankan.sh\" mulai",
            "timeout": 900
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/jalankan.sh\" lanjut",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/jalankan.sh\" jaga",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
